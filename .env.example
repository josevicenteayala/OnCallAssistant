# Copy to .env and fill in. NEVER commit the real .env.
SLACK_BOT_TOKEN=xoxb-...       # bot token; export needs channels:history, channels:read, users:read
AWS_REGION=us-east-1           # your Bedrock/S3 region
BEDROCK_MODEL_ID=              # Converse-capable model/inference-profile id enabled in Bedrock
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0   # Titan embeddings for the local index
# Backfill upload (make upload):
S3_BUCKET_NAME=                # bucket holding events/ and cases/
BEDROCK_KB_ID=                 # Knowledge Base id
BEDROCK_DATA_SOURCE_ID=        # KB data source id (for --sync)
